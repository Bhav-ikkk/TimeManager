# Copy to .env.local and fill in. Never commit real values.

# USDA FoodData Central API key (free: https://fdc.nal.usda.gov/api-key-signup).
# Optional — users can also paste their own key in Calories → Settings.
# NEXT_PUBLIC_ variables are embedded in the client bundle at build time.
NEXT_PUBLIC_USDA_FDC_KEY=

# ---------------------------------------------------------------------------
# Friends feature backend (optional — the app is fully local-only without it)
# ---------------------------------------------------------------------------

# Neon Postgres connection string (free tier: https://neon.tech).
# After setting it, apply the schema with: npm run db:migrate
DATABASE_URL=

# Auth.js session encryption secret. Generate with: npx auth secret
AUTH_SECRET=

# GitHub OAuth app (github.com → Settings → Developer settings → OAuth Apps).
# Homepage URL: your app origin. Callback URL: <origin>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
